( function( $ ) {
 
    const language = ajax_auth_object.lang || 'en';

    function loginHandler() {
        console.log('Login handler initialized', language);

        $('#loginForm').submit(function(e) {
            e.preventDefault();
            const email = $('#email_login').val();
            const password = $('#password_login').val();
            console.log('Form submitted with:', { email, password });

            const data = {
                action: 'ajax_login',
                email: email,
                password: password,
                security: ajax_auth_object.nonce
            };
            $.ajax({
                type: 'POST',
                url: ajax_auth_object.ajaxurl,
                data: data,
                beforeSend: function() {
                    $('#signButton').prop('disabled', true);
                    $('#signButton').text('Signing in...');
                },
                success: function(response) {
                    console.log('Login response:', response);

                    // Expecting response format:
                    // { "success": true, "data": { "redirect": "https://colorbond-aw-dev.com" } }
                    try {
                        const success = response && (response.success === true || response.success === 'true');
                        const redirectUrl = response && response.data && response.data.redirect;

                        if (success && redirectUrl) {
                            window.location.href = redirectUrl;
                            return;
                        } else {
                            // Kalau success = false, tampilkan Swal error
                            Swal.fire({
                                icon: 'error',
                                title: 'Login gagal',
                                text: 'Email atau password salah.'
                            });
                        }
                    } catch (err) {
                        console.error('Error handling login response:', err);
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Login error:', error);
                }
            }).done(function() {
                $('#signButton').prop('disabled', false);
                $('#signButton').text('Sign In');
            });
           
        });
    }

    function logoutHandler() {
        $('.colorbond-logout-link').on('click', function(e) {
            e.preventDefault();

            $.ajax({
                type: 'POST',
                url: ajax_auth_object.ajaxurl,
                data: {
                    action: 'ajax_logout',
                    security: ajax_auth_object.nonce
                },
                success: function(response) {
                    console.log('Logout response:', response);

                    try {
                        const success = response && (response.success === true || response.success === 'true');
                        const redirectUrl = response && response.data && response.data.redirect;

                        if (success && redirectUrl) {
                            window.location.href = redirectUrl;
                            return;
                        }
                    } catch (err) {
                        console.error('Error handling logout response:', err);
                    }

                    // Fallback: reload current page
                    window.location.reload();
                },
                error: function(xhr, status, error) {
                    console.error('Logout error:', error);
                }
            });
        });
    }

    function registerHandler() {
        console.log('Register handler initialized');

        $('#registerForm').validate({
            rules: {
                fullname: "required",
                email: {
                    required: true,
                    email: true
                },
                pwd: {
                    required: true,
                    minlength: 6
                },
                confirm_password: {
                    required: true,
                    equalTo: "#pwd"
                },
                phone: {
                    required: true,
                    digits: true,
                    minlength: 10
                },
                role: {
                    required: true,
                },

                term_privacy : "required",
			    
                declare : "required"
                
            },
            messages: {
                fullname: "Please enter your full name",

                email: {
                    required: "Please enter your email address",
                    email: "Please enter a valid email address"
                },
                pwd: {
                    required: "Please provide a password",
                    minlength: "Your password must be at least 6 characters long"
                },
                confirm_password: {
                    required: "Please confirm your password",
                    equalTo: "Passwords do not match"
                },
                phone: {
                    required: "Please enter your whatsapp number",
                    digits: "Please enter only digits",
                    minlength: "Your whatsapp number must be at least 10 digits long"
                },
                role: "Please select role",
            },
            submitHandler: function(form) {
                // grecaptcha.ready(function() {
                //     grecaptcha.execute(submit._google_captcha, {action: 'submit'}).then(function(token) {
                //         const formData = $(form).serializeArray();
                //         const formDataObj = {};
                //             formData.forEach(item => {
                //                 formDataObj[item.name] = item.value;
                //             });

                //         console.log('Form data ready for submission:', formDataObj);

                //         $.ajax({
                //             url: ajax_auth_object.ajaxurl,
                //             type: 'POST',
                //             data: {
                //                 action: 'ajax_register',
                //                 ...formDataObj,
                //                 security: ajax_auth_object.nonce
                //             },
                //             success: function(response) {
                //                 console.log('Success:', response);
                //                 $('#registerForm')[0].reset();
                //                 $('#modalThankYou').modal('show');
                //             },
                //             error: function(xhr) {
                //                 console.error('Error:', xhr);
                //             }
                //         });
                //     });
                // });

                    let formData = new FormData(form);
                    grecaptcha.ready(function() {
                        grecaptcha.execute(submit._google_captcha, {action: 'submit'}).then(function(token) {

                            formData.append('g-recaptcha-response', token);
                            formData.append('action', '_POST_submit');
                            formData.append('_ajax_nonce', submit._ajax_nonce_submit);
                            
                            $.ajax({
                                type: 'POST',
                                url: submit._ajax_url_submit,
                                processData: false,
                                contentType: false,
                                cache: false,
                                data: formData,
                                beforeSend: function() {
                                   $('#submit-register').prop('disabled', true);
                                   $('#submit-register').text('Processing...');
                                },

                                enctype: 'multipart/form-data',

                                success: function(result) {	
                                   if(result.success) {
                                       $('#resultRegister').html(`<b>Project ID: <span style="color:${result.data.color}">${result.data.project_id}</span></b>`);
                                       $('#resultProjectName').html(`<b>Thank you for submitting your project to The Steel Architectural Awards 2026.</b> <br>Your submission for ${result.data.project_name} has been received. Please keep the following Submission ID for your reference:`);
                                       $('#modalThankYou').modal('show');
                                       if (form && typeof form.reset === 'function') {
                                           form.reset();
                                       }
                                       $(form).find('input[type="file"]').val('');
                                   } else {
                                      // Tambahkan alert error dengan Swal
