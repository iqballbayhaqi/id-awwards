                    },
                    pagination: {
                        el: ".swp-carousel .swiper-pg-"+ i,
                        dynamicBullets: true,
                        clickable: true,
                    }
                });
            }
        }else {

            swpSwiper = new Swiper(".swp-carousel .swiper", {
